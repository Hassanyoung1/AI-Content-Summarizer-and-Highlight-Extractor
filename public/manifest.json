{
  "name": "AI Content Summarizer and Highlight Extractor",
  "version": "1.0",
  "manifest_version": 3,
  "description": "Summarize and extract highlights from web content.",
  "permissions": ["activeTab"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "sidebar.html",
    "default_icon": "icons/icon.png"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
